# The real local workbook lives at repository root and must never be committed.
# Do not use *.xlsx here: it would hide source directories named *.Xlsx.
/*.xlsx
# Signed timetable PDFs are local source data; keep fixtures under project test folders explicit.
/*.pdf

# Generated formal documents
formal/spec/*.pdf
# CaDiCaL generates these proxy makefiles during configure.
scheduler/desktop/native/SolverWorker/third_party/cadical/makefile
scheduler/desktop/native/SolverWorker/third_party/cadical/src/makefile
*.log
